# Copy this file to deploy/.env.production on the EC2 host only.
# Secrets below are placeholders. Generate unique values; never commit the real file.

# Public edge — always required in both modes.
DEMO_AUTH_USER=demo
# SECRET: output of `caddy hash-password`; single-quote real hashes containing `$`.
DEMO_AUTH_PASSWORD_HASH=REPLACE_WITH_CADDY_PASSWORD_HASH

# Mode B (domain + HTTPS) only. These may be omitted entirely in Mode A.
ROUTELLM_DOMAIN=api.example.com
ACME_EMAIL=operator@example.com

# Mode A (domainless HTTP) needs no additional environment variables. Its public
# address is the EC2 instance's current public IPv4 address or public hostname.

# Vercel AI Gateway
# SECRET
AI_GATEWAY_API_KEY=REPLACE_WITH_GATEWAY_KEY
AI_GATEWAY_TIMEOUT_SECONDS=60
INFERENCE_DEADLINE_SECONDS=60

# PostgreSQL bootstrap and non-superuser runtime identity.
POSTGRES_DB=routellm
POSTGRES_USER=routellm_admin
# SECRET: use URL-safe random values because the app password is embedded in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_BOOTSTRAP_PASSWORD
POSTGRES_APP_USER=routellm
# SECRET: use a URL-safe random value.
POSTGRES_APP_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
TELEMETRY_TIMEOUT_SECONDS=2

# Redis-backed paid-inference admission
REDIS_URL=redis://redis:6379/0
# SECRET: at least 32 random characters.
RATE_LIMIT_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
REDIS_TIMEOUT_SECONDS=0.25
RATE_LIMIT_CLIENT_CAPACITY=5
RATE_LIMIT_CLIENT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_CAPACITY=20
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_EXPLICIT_WEIGHT=1
RATE_LIMIT_ADAPTIVE_WEIGHT=2

# Internal-only Prometheus endpoint
METRICS_ENABLED=true
# SECRET: at least 32 random characters.
METRICS_BEARER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Frozen router (the image owns these paths and identities)
ROUTELLM_ADAPTIVE_ARTIFACT_PATH=/app/deploy/router
ROUTELLM_ADAPTIVE_CANDIDATES=candidate-claude-sonnet-5,candidate-gemini-3-flash,candidate-gpt-6-luna,candidate-nemotron-3.5-lightning

# Public API cost-safety bounds. Code also enforces hard ceilings.
ROUTELLM_MAX_PROMPT_CHARACTERS=12000
ROUTELLM_MAX_OUTPUT_TOKENS=512
