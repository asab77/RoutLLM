# Public Docker development credentials only; never use for deployed databases.
# FastAPI/Python run on macOS; PostgreSQL runs in Docker on loopback port 5432.
DATABASE_URL=postgresql+asyncpg://routellm:local_dev_only@127.0.0.1:5432/routellm
TEST_DATABASE_URL=postgresql+asyncpg://routellm_test:local_test_only@127.0.0.1:5432/routellm_test
TELEMETRY_TIMEOUT_SECONDS=2

# Vercel gateway key belongs only in ignored .env; blank keeps offline mode.
AI_GATEWAY_API_KEY=
AI_GATEWAY_TIMEOUT_SECONDS=60
# Total budget shared by routing, provider attempts, validation, and telemetry.
INFERENCE_DEADLINE_SECONDS=60

# Distributed inference admission. These are conservative local-development
# placeholders, not final production quotas. Public deployment must set
# RATE_LIMIT_REQUIRED=true and use a unique secret of at least 32 characters.
RATE_LIMIT_REQUIRED=false
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_HMAC_SECRET=local-development-only-change-this-secret
REDIS_TIMEOUT_SECONDS=0.25
RATE_LIMIT_CLIENT_CAPACITY=10
RATE_LIMIT_CLIENT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_CAPACITY=100
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_EXPLICIT_WEIGHT=1
RATE_LIMIT_ADAPTIVE_WEIGHT=2

# Local-only Prometheus scrape authentication. Replace both this value and the
# matching placeholder in observability/prometheus/prometheus.yml outside local demo use.
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=local-observability-token-change-me-123
# Grafana Compose defaults are development-only and are not a deployment design.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local_dev_only_change_me
# Root for controlled benchmark/evaluation artifacts; API accepts UUIDs, not paths.
BENCHMARK_RESULTS_DIR=benchmark-results

# Optional adaptive HTTP mode. Leave both blank to disable it. When enabled,
# supply a trusted local Phase 8C artifact directory and unique registry model IDs.
ROUTELLM_ADAPTIVE_ARTIFACT_PATH=
ROUTELLM_ADAPTIVE_CANDIDATES=

# Required by POST /v1/chat. AUTO uses this enabled registry model directly;
# MANUAL uses an explicit category with the separately configured adaptive router.
ROUTELLM_DEFAULT_MODEL_ID=
